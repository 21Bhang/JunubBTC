# LNbits instance (use your own or https://demo.lnbits.com for dev only)
EXPO_PUBLIC_LNBITS_URL=https://demo.lnbits.com
# Invoice/Read key from your LNbits wallet (DO NOT commit real keys)
EXPO_PUBLIC_LNBITS_INVOICE_KEY=replace_me
# Admin key (only if you need pay invoice from app — prefer a backend proxy in production)
EXPO_PUBLIC_LNBITS_ADMIN_KEY=replace_me

# Manual SSP-per-BTC rate fallback when no price feed is reachable
EXPO_PUBLIC_SSP_PER_BTC=350000000
