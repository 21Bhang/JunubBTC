# LNbits instance (use your own or https://demo.lnbits.com for dev only)
EXPO_PUBLIC_LNBITS_URL=https://demo.lnbits.com
# Invoice/Read key from your LNbits wallet (DO NOT commit real keys)
EXPO_PUBLIC_LNBITS_INVOICE_KEY=replace_me
# Admin key (only if you need pay invoice from app — prefer a backend proxy in production)
EXPO_PUBLIC_LNBITS_ADMIN_KEY=replace_me

# JunubBTC bridge backend (server that creates payouts and routes
# fees to JunubBTC's bank account). Leave blank to run in local demo mode.
EXPO_PUBLIC_BRIDGE_URL=
EXPO_PUBLIC_BRIDGE_KEY=

# SSP per 1 USD — South Sudan parallel-market rate (1 USD ≈ 5,200 SSP).
EXPO_PUBLIC_SSP_PER_USD=5200

# Optional: hard override for SSP-per-BTC. If set, the live BTC/USD feed
# and SSP-per-USD multiplier are ignored.
# EXPO_PUBLIC_SSP_PER_BTC=350000000

# Optional: alternative BTC/USD price feed URL.
# EXPO_PUBLIC_BTC_USD_URL=https://api.coingecko.com/api/v3/simple/price?ids=bitcoin&vs_currencies=usd
